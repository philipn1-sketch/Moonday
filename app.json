{
  "expo": {
    "name": "Moonday",
    "slug": "moonday",
    "scheme": "moonday",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#14132B",
    "ios": {
      "bundleIdentifier": "com.philipnader.moonday",
      "supportsTablet": false,
      "appleTeamId": "9QLBWXC74X",
      "config": { "usesNonExemptEncryption": false },
      "infoPlist": { "ITSAppUsesNonExemptEncryption": false }
    },
    "web": { "output": "single", "favicon": "./assets/favicon.png" },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      ["expo-localization", { "supportedLocales": { "ios": ["en", "es", "fr", "de", "it", "pt", "nl", "ja", "zh-Hans", "ko"] } }]
    ],
    "experiments": { "typedRoutes": false }
  }
}
